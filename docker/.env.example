# Copy to .env and adjust. `docker compose` reads this file automatically.

# --- Image ---------------------------------------------------------------
EVALSCOPE_IMAGE=evalscope:latest
EVALSCOPE_CONTAINER_NAME=evalscope

# --- Network -------------------------------------------------------------
# 0.0.0.0 exposes the dashboard on every interface; use 127.0.0.1 to keep it local
# and reach it through a reverse proxy, firewall rule or SSH tunnel.
EVALSCOPE_BIND_ADDRESS=0.0.0.0
EVALSCOPE_PORT=9000

# --- Timezone ------------------------------------------------------------
# AIPerf log ticks and report timestamps use the container's local timezone.
TZ=Asia/Shanghai

# --- Build mirrors -------------------------------------------------------
# Defaults point at the official registries. For mainland China networks, use:
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
NPM_REGISTRY=https://registry.npmjs.org

# --- Versions ------------------------------------------------------------
PYTHON_VERSION=3.12
NODE_VERSION=22
# This repository only ships the linux/x86_64 CPython 3.12 lock.
AIPERF_LOCK_FILE=requirements/aiperf-linux-x86_64-py312.lock

# --- Data ---------------------------------------------------------------
# Leave empty to use the named volumes declared in docker-compose.yml.
# To store data on the host instead, create the directories first and give the
# container user ownership:
#   mkdir -p /srv/evalscope/outputs /srv/evalscope/cache
#   sudo chown -R 1000:1000 /srv/evalscope
EVALSCOPE_OUTPUTS_MOUNT=
EVALSCOPE_CACHE_MOUNT=
EVALSCOPE_OUTPUTS_VOLUME=evalscope_outputs
EVALSCOPE_CACHE_VOLUME=evalscope_cache

# --- Container user ------------------------------------------------------
# Must match the owner of any bind-mounted data directories.
EVALSCOPE_UID=1000
EVALSCOPE_GID=1000

# --- AIPerf --------------------------------------------------------------
# Absolute path inside the container; override only for a custom image.
EVALSCOPE_AIPERF_EXECUTABLE=/opt/aiperf-venv/bin/aiperf
